# =============================================================================
# Buscador Semántico Local — Variables para desarrollo LOCAL (sin Docker)
# =============================================================================
# Usa este fichero si quieres ejecutar la app directamente con Python,
# sin Docker Compose. Copia a .env y ajusta los valores.
#
#   cp .env.local.example .env
#   python -m src.cli health
#
# Diferencias con el .env de Docker:
#   - CHROMA_HOST apunta a localhost (no al hostname Docker "chromadb")
#   - NOTES_DIR apunta a ./notas (ruta local, no /notas del contenedor)
#   - ChromaDB debe estar corriendo: docker compose up -d chromadb
# =============================================================================

# --- Ollama ---
# EJEMPLO con IP de documentación (RFC 5737, no enrutable). Pon la IP real de tu servidor.
OLLAMA_BASE_URL=http://192.0.2.1:11434
EMBEDDING_MODEL=nomic-embed-text

# --- ChromaDB ---
# "localhost" porque accedemos desde fuera de Docker, via el puerto mapeado.
CHROMA_HOST=localhost
CHROMA_PORT=8000
COLLECTION_NAME=notas

# --- Notas ---
# Ruta local al directorio de notas (relativa al CWD o absoluta).
NOTES_DIR=./notas

# --- Logging ---
# Sube a DEBUG para ver peticiones HTTP y tiempos de cada paso.
LOG_LEVEL=INFO

# --- Chunking (valores por defecto razonables, descomentar para ajustar) ---
# MAX_CHUNK_TOKENS=300
# MIN_CHUNK_TOKENS=100
# OVERLAP_TOKENS=50

# --- Embeddings (ajustar si Ollama va lento o da timeouts) ---
# EMBED_BATCH_SIZE=50
# EMBED_TIMEOUT=120
# EMBED_RETRIES=3

# --- Búsqueda ---
# DEFAULT_N_RESULTS=5
# PREVIEW_MAX_CHARS=200
