# =============================================================================
# Buscador Semántico Local — Variables de entorno
# =============================================================================
# Copia este fichero a .env y rellena los valores reales:
#   cp example.env .env
# =============================================================================

# --- Ollama (servidor de modelos de IA) ---
# URL base del servidor Ollama. Debe incluir protocolo y puerto.
# Ejemplo: si Ollama corre en un servidor local (IP de documentación RFC 5737)
OLLAMA_BASE_URL=http://192.0.2.1:11434

# Modelo de embeddings a usar. nomic-embed-text es la mejor opción para
# contenido en español con hardware limitado (CPU only, ~274MB de modelo).
# Alternativas: all-minilm (más rápido, peor en español), mxbai-embed-large (mejor calidad, más lento)
EMBEDDING_MODEL=nomic-embed-text

# --- ChromaDB (base de datos vectorial) ---
# Estos valores son para la comunicación DENTRO de Docker Compose.
# "chromadb" es el nombre del servicio en docker-compose.yml (Docker resuelve el DNS).
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Nombre de la colección en ChromaDB. Una colección es como una "tabla"
# donde se almacenan todos los vectores y sus metadatos.
COLLECTION_NAME=notas

# --- Directorio de notas ---
# Ruta DENTRO del contenedor Docker donde se montan las notas.
# En docker-compose.yml se mapea ${NOTES_HOST_DIR}:/notas:ro (read-only).
# No cambies esto a menos que modifiques también el docker-compose.yml.
NOTES_DIR=/notas

# Ruta en el HOST (tu máquina) donde están las notas Markdown.
# docker-compose.yml usa esta variable para montar el volumen en :ro.
# Puede ser relativa (al directorio del proyecto) o absoluta.
# Ejemplos:
#   ./notas                              → directorio local (default)
#   /home/usuario/Documentos/mi-vault    → ruta absoluta a tu vault
#   /Users/usuario/Obsidian/notas        → vault de Obsidian en macOS
NOTES_HOST_DIR=./notas

# Directorios a ignorar al escanear notas (separados por coma).
# Por defecto ignora carpetas de Obsidian, git, papelera y plantillas.
# Añade los que necesites, ej: .obsidian,.trash,.git,_templates,_archive
# NOTES_IGNORE_DIRS=.obsidian,.trash,.git,_templates

# --- Logging ---
# Nivel de detalle de los logs. Valores: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Sube a DEBUG para depurar problemas con Ollama o ChromaDB.
LOG_LEVEL=WARNING

# --- Chunking (valores por defecto razonables, descomentar para ajustar) ---
# Tamaño máximo de un chunk en tokens (~300 tokens ≈ 200-250 palabras).
# MAX_CHUNK_TOKENS=300
# Tamaño mínimo de un chunk en tokens (evita chunks demasiado cortos).
# MIN_CHUNK_TOKENS=100
# Tokens de solapamiento entre chunks consecutivos.
# OVERLAP_TOKENS=50

# --- Embeddings (ajustar si Ollama va lento o da timeouts) ---
# Textos por petición a Ollama. Bajar si hay poca RAM.
# EMBED_BATCH_SIZE=50
# Timeout en segundos por petición a Ollama.
# EMBED_TIMEOUT=120
# Reintentos si Ollama falla (con backoff exponencial).
# EMBED_RETRIES=3

# --- Búsqueda ---
# Número de resultados por defecto.
# DEFAULT_N_RESULTS=5
# Longitud máxima del preview de texto en resultados.
# PREVIEW_MAX_CHARS=200
